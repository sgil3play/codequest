<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<!--
			3.5.3 y no la ultima (4.x): es la linea que corre en produccion en mi
			trabajo actual. Mantengo el stack del CV y del equipo, que es lo que
			se va a revisar en una entrevista.
		-->
		<version>3.5.3</version>
		<relativePath/>
	</parent>

	<groupId>com.codequest</groupId>
	<artifactId>codequest</artifactId>
	<version>0.1.0</version>
	<name>codequest</name>
	<description>Plataforma de practica de codigo para preparar entrevistas tecnicas</description>

	<properties>
		<java.version>21</java.version>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<!-- Fijados para que el jar standalone de JUnit use exactamente la misma
		     version de la plataforma que las dependencias de test del proyecto. -->
		<junit-jupiter.version>5.11.4</junit-jupiter.version>
		<junit-platform.version>1.11.4</junit-platform.version>
		<springdoc.version>2.8.9</springdoc.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!-- Persistencia del progreso (H2 en fichero: cero friccion para arrancar
		     y el progreso sobrevive a los reinicios) -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Catalogo de retos en YAML: el codigo Java dentro del catalogo se lee
		     mucho mejor con literales de bloque que con escapes de JSON. -->
		<dependency>
			<groupId>com.fasterxml.jackson.dataformat</groupId>
			<artifactId>jackson-dataformat-yaml</artifactId>
		</dependency>

		<!-- Swagger / OpenAPI -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>${springdoc.version}</version>
		</dependency>

		<!-- Motor de ejecucion de katas: se ejecuta FUERA del proceso de Spring,
		     en una JVM aislada, con timeout. De aqui sale el jar standalone. -->
		<dependency>
			<groupId>org.junit.platform</groupId>
			<artifactId>junit-platform-console-standalone</artifactId>
			<version>${junit-platform.version}</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>

			<!-- Los tests usan una base en memoria propia (src/test/resources/
			     application-test.yml) y no el fichero de la aplicacion: H2 en
			     modo fichero bloquea el .mv.db y no admite dos JVM a la vez. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<systemPropertyVariables>
						<spring.profiles.active>test</spring.profiles.active>
					</systemPropertyVariables>
				</configuration>
			</plugin>

			<!-- Copia el launcher standalone de JUnit a target/ para que el runner
			     pueda invocar `java -jar` sobre el codigo del usuario. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<id>copy-junit-console-standalone</id>
						<phase>generate-resources</phase>
						<goals>
							<goal>copy</goal>
						</goals>
						<configuration>
							<artifactItems>
								<artifactItem>
									<groupId>org.junit.platform</groupId>
									<artifactId>junit-platform-console-standalone</artifactId>
									<version>${junit-platform.version}</version>
									<outputDirectory>${project.build.directory}</outputDirectory>
									<destFileName>junit-platform-console-standalone.jar</destFileName>
								</artifactItem>
							</artifactItems>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
